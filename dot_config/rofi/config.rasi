@import "default"

* {
    bg0-h:   #1d2021;
    bg0:     #282828;
    bg0-s:   #32302f;
    bg1:     #3c3836;
    bg2:     #504945;
    bg3:     #665c54;
    bg4:     #7c6f64;

    fg0:     #fbf1c7;
    fg1:     #ebdbb2;
    fg2:     #d5c4a1;
    fg3:     #bdae93;
    fg4:     #a89984;
    gray:    #928374;

    red:     #fb4934;
    green:   #b8bb26;
    yellow:  #fabd2f;
    blue:    #83a598;
    purple:  #d3869b;
    aqua:    #8ec07c;
    orange:  #fe8019;

    /* тёмные (neutral/faded) варианты */
    yellow-dark:  #d79921;
    yellow-faded: #b57614;

    font: "GeistMono NFM SemiBold 8";

    accent:    @yellow-dark;

    bg-normal: @bg0;
    bg-active: @accent;
    bg-urgent: @red;
    fg-normal: @fg1;
}

#window {
    background-color: @bg-normal;
    padding: 5;

    location: north;
    anchor: north;
    y-offset: 26px;

    width: 176px;

    border: 0px;
}

#mainbox {
    padding: 1px;
}

#textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em;
    text-color: @accent;
}

/* Prompt */
#prompt {
    spacing:    0;
    text-color: @accent;
}

#entry {
    spacing:    0;
    text-color: @fg-normal;
}

/* Elements */
#element {
    padding: 1px;
}

element normal.normal,
element normal.urgent,
element alternate.normal,
element alternate.active,
element alternate.urgent {
    background-color: @bg-normal;
    text-color: @fg-normal;
}

element selected.normal,
element selected.active,
element selected.urgent,
element alternate.selected,
button selected {
    background-color: @bg-active;
    text-color: @bg-normal;
}

#textbox {
    text-color: @fg-normal;
}

#message {
    padding: 1px;
}

#listview {
    border: 0px;
    scrollbar: false;
}

#scrollbar {
    width:        2px;
    handle-width: 8px;
    padding:      0;
}

#inputbar {
    spacing:    0;
    text-color: @fg-normal;
    padding:    1px;
    children:   [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

#case-indicator {
    spacing:    0;
    text-color: @fg-normal;
}
